extends ../layout

block content
  .d-flex.justify-content-between.align-items-center.mb-3
    h2= asset.serialNumber
    .d-flex.gap-2
      a.btn.btn-outline-primary(href=`/assets/${asset.id}/edit`) Edit
      a.btn.btn-outline-dark(href=`/history/${asset.id}`) View History

  dl.row
    dt.col-sm-3 Unique ID
    dd.col-sm-9
      code= asset.id
    dt.col-sm-3 Category
    dd.col-sm-9= asset.category ? asset.category.name : '-'
    dt.col-sm-3 Make / Model
    dd.col-sm-9= `${asset.make || ''} ${asset.model || ''}`
    dt.col-sm-3 Branch
    dd.col-sm-9= asset.branch || '-'
    dt.col-sm-3 Purchase Date
    dd.col-sm-9= asset.purchaseDate || '-'
    dt.col-sm-3 Purchase Value
    dd.col-sm-9= Number(asset.purchaseValue).toLocaleString('en-IN', {style:'currency', currency:'INR', maximumFractionDigits:0})
    dt.col-sm-3 Status
    dd.col-sm-9
      if asset.status === 'IN_STOCK'
        span.badge.bg-success In Stock
      else if asset.status === 'ISSUED'
        span.badge.bg-warning.text-dark Issued
      else
        span.badge.bg-danger Scrapped
    if asset.currentEmployee
      dt.col-sm-3 Held By
      dd.col-sm-9
        a(href=`/employees/${asset.currentEmployee.id}`)= asset.currentEmployee.name
    dt.col-sm-3 Notes
    dd.col-sm-9= asset.notes || '-'
