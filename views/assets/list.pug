extends ../layout

block content
  .d-flex.justify-content-between.align-items-center.mb-3
    h2 Asset Master
    a.btn.btn-primary(href="/assets/new") + Add Asset

  form.row.g-2.mb-3(method="GET" action="/assets")
    .col-auto
      select.form-select(name="categoryId" onchange="this.form.submit()")
        option(value="") All Categories
        each cat in categories
          option(value=cat.id selected=(String(filters.categoryId)===String(cat.id)))= cat.name
    .col-auto
      input.form-control(type="text" name="q" placeholder="Search serial, make, model" value=filters.q)
    .col-auto
      button.btn.btn-outline-secondary(type="submit") Search

  table#assetsTable.table.table-striped.table-hover.w-100
    thead
      tr
        th Serial No.
        th Category
        th Make / Model
        th Branch
        th Value
        th Status
        th Held By
        th Actions
    tbody
      each a in assets
        tr
          td
            a(href=`/assets/${a.id}`)= a.serialNumber
          td= a.category ? a.category.name : '-'
          td= `${a.make || ''} ${a.model || ''}`
          td= a.branch || '-'
          td= Number(a.purchaseValue).toLocaleString('en-IN', {style:'currency', currency:'INR', maximumFractionDigits:0})
          td
            if a.status === 'IN_STOCK'
              span.badge.bg-success In Stock
            else if a.status === 'ISSUED'
              span.badge.bg-warning.text-dark Issued
            else
              span.badge.bg-danger Scrapped
          td= a.currentEmployee ? a.currentEmployee.name : '-'
          td
            a.btn.btn-sm.btn-outline-primary(href=`/assets/${a.id}/edit`) Edit

block scripts
  script.
    $(function () {
      $('#assetsTable').DataTable({ order: [] });
    });
