extends ../layout

block content
  .d-flex.justify-content-between.align-items-center.mb-3
    h2= employee.name
    a.btn.btn-outline-primary(href=`/employees/${employee.id}/edit`) Edit

  dl.row
    dt.col-sm-3 Employee Code
    dd.col-sm-9= employee.employeeCode
    dt.col-sm-3 Email
    dd.col-sm-9= employee.email || '-'
    dt.col-sm-3 Phone
    dd.col-sm-9= employee.phone || '-'
    dt.col-sm-3 Department
    dd.col-sm-9= employee.department || '-'
    dt.col-sm-3 Designation
    dd.col-sm-9= employee.designation || '-'
    dt.col-sm-3 Branch
    dd.col-sm-9= employee.branch || '-'
    dt.col-sm-3 Status
    dd.col-sm-9
      if employee.isActive
        span.badge.bg-success Active
      else
        span.badge.bg-secondary Inactive

  h4.mt-4 Assets Currently Held
  if employee.assetsHeld && employee.assetsHeld.length
    table.table.table-sm
      thead
        tr
          th Serial Number
          th Make/Model
      tbody
        each a in employee.assetsHeld
          tr
            td
              a(href=`/assets/${a.id}`)= a.serialNumber
            td= `${a.make || ''} ${a.model || ''}`
  else
    p.text-muted No assets currently issued.
