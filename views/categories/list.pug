extends ../layout

block content
  .d-flex.justify-content-between.align-items-center.mb-3
    h2 Asset Category Master
    a.btn.btn-primary(href="/categories/new") + Add Category

  table#categoriesTable.table.table-striped.table-hover.w-100
    thead
      tr
        th Name
        th Description
        th Actions
    tbody
      each cat in categories
        tr
          td= cat.name
          td= cat.description || '-'
          td
            a.btn.btn-sm.btn-outline-primary(href=`/categories/${cat.id}/edit`) Edit

block scripts
  script.
    $(function () {
      $('#categoriesTable').DataTable({ order: [] });
    });
