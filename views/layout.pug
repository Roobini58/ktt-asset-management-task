doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title ? `${title} · Asset Management` : 'Asset Management'
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet" href="https://cdn.datatables.net/1.13.11/css/dataTables.bootstrap5.min.css")
    link(rel="stylesheet" href="/css/style.css")
  body
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark
      .container-fluid
        a.navbar-brand(href="/") Asset Management
        button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navMain")
          span.navbar-toggler-icon
        #navMain.collapse.navbar-collapse
          ul.navbar-nav.me-auto
            li.nav-item
              a.nav-link(href="/employees") Employees
            li.nav-item
              a.nav-link(href="/categories") Categories
            li.nav-item
              a.nav-link(href="/assets") Assets
            li.nav-item
              a.nav-link(href="/stock") Stock View
            li.nav-item
              a.nav-link(href="/issue") Issue
            li.nav-item
              a.nav-link(href="/return") Return
            li.nav-item
              a.nav-link(href="/scrap") Scrap
            li.nav-item
              a.nav-link(href="/history") History
            li.nav-item
              a.nav-link(href="/reports") Reports

    .container.mt-4.mb-5
      if success && success.length
        each msg in success
          .alert.alert-success.alert-dismissible.fade.show(role="alert")
            = msg
            button.btn-close(type="button" data-bs-dismiss="alert")
      if error && error.length
        each msg in error
          .alert.alert-danger.alert-dismissible.fade.show(role="alert")
            = msg
            button.btn-close(type="button" data-bs-dismiss="alert")

      block content

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
    script(src="https://code.jquery.com/jquery-3.7.1.min.js")
    script(src="https://cdn.datatables.net/1.13.11/js/jquery.dataTables.min.js")
    script(src="https://cdn.datatables.net/1.13.11/js/dataTables.bootstrap5.min.js")
    script(src="/js/main.js")
    block scripts
